{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/guard-git-commit.sh"
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/guard-git-push.sh"
          },
          {
            "type": "command",
            "if": "Bash(mysql *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/guard-sql-readonly.sh"
          },
          {
            "type": "command",
            "if": "Bash(psql *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/guard-sql-readonly.sh"
          },
          {
            "type": "command",
            "if": "Bash(sqlite3 *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/guard-sql-readonly.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/check-pr-drift.sh"
          }
        ]
      }
    ]
  }
}
